# Какой LLM использовать: gigachat | deepseek | mock
# GigaChat: заполнить GIGACHAT_CREDENTIALS, проверить командой  python -m backend.llm.check --chat
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-совместимый API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GigaChat API. Ключ авторизации (Authorization key) — в личном кабинете GigaChat API, «Получить ключ».
# Токен агент получает сам (POST https://ngw.devices.sberbank.ru:9443/api/v2/oauth) и обновляет каждые ~30 минут.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL=true
# Сертификат НУЦ Минцифры (если ошибка SSL): путь к russian_trusted_root_ca.cer
GIGACHAT_CA_BUNDLE=

# Если реальный LLM недоступен — переключаться на офлайн-сценарий
LLM_FALLBACK_TO_MOCK=true

# Распознавание речи на сервере (faster-whisper): small | base | medium
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Площадки объявлений (через запятую). Сейчас подключён только Циан
SOURCES=cian

# База данных: по умолчанию SQLite в backend/data/app.db. PostgreSQL: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=
# Сколько часов выдача из базы считается свежей (не ходим на Циан повторно)
LISTINGS_FRESH_HOURS=24
# Ежедневный обход объявлений внутри сервера, «ЧЧ:ММ» (пусто — выключен; есть отдельный воркер)
REFRESH_AT=
REFRESH_PAGES=3
REMOVE_AFTER_MISSES=2
# Проверка страницы объявления перед показом: доверять прошлой проверке N минут; ждать подборку не дольше N секунд
LISTING_CHECK_TTL_MIN=30
LISTING_CHECK_BUDGET_S=25
# Скачивать фото квартир на диск
STORE_PHOTOS=false

# Пользователи: срок входа (дней), почты администраторов через запятую, Secure-cookie за HTTPS
AUTH_SESSION_DAYS=30
ADMIN_EMAILS=
COOKIE_SECURE=false
