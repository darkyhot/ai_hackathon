# Какой LLM использовать: deepseek | gigachat
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-совместимый API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GigaChat: готовый Authorization Key без префикса Basic.
# При наличии Client ID и Client Secret: base64 от строки Client ID:Client Secret.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=true
# Необязательно: свой CA bundle. Сертификат НУЦ Минцифры включён в backend/certs.
GIGACHAT_CA_BUNDLE=

# Защита демо от зависаний и перегрузки (один процесс backend).
# Активная работа одного хода; ожидание ответа человека не учитывается.
AGENT_TURN_TIMEOUT_S=120
# Число ожидающих генерацию GigaChat, помимо одного выполняемого запроса.
GIGACHAT_QUEUE_SIZE=6
GIGACHAT_QUEUE_TIMEOUT_S=25
# Весь вызов модели, включая OAuth/повторы, после выхода из очереди.
LLM_CALL_TIMEOUT_S=60


# Распознавание речи на сервере (faster-whisper): small | base | medium
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Voximplant — звонок продавцу на настоящий телефон (звонок, голос агента и распознавание — в облаке Voximplant).
# Доступ: ID аккаунта и API-ключ (manage.voximplant.com → Настройки → API-ключи)
VOXIMPLANT_ACCOUNT_ID=
VOXIMPLANT_API_KEY=
# …или вместо них путь к JSON-файлу сервисного аккаунта (файл в git не кладите)
VOXIMPLANT_CREDENTIALS=
# Приложение, сценарий, правило и пользователь создаются сами при первом звонке.
VOXIMPLANT_APP=domclick-agent
# Узел аккаунта (NODE_4 и т.п., виден на главной кабинета). Пусто — определяется сам по домену приложения.
VOXIMPLANT_NODE=
# Адрес Management API. Если кабинет manage.voximplant.ru показывает другой адрес API — укажите его здесь.
VOXIMPLANT_API_HOST=api.voximplant.com
# Номер, с которого звонить: арендованный в Voximplant или подтверждённый Caller ID. Пусто — первый арендованный.
VOXIMPLANT_CALLER_ID=
# Голос агента и распознавание (имена из VoiceList / ASRProfileList Voximplant)
VOXIMPLANT_VOICE=SaluteSpeech.ru_RU_sergey
VOXIMPLANT_ASR=SaluteSpeech.ru_RU
SELLER_PHONE=
# На публичном сервере обязательно: без PIN любой посетитель сможет звонить за ваш счёт
PHONE_PIN=

# База агента: пользователи, история диалогов, объявления с признаками.
# По умолчанию SQLite в backend/data/app.db; PostgreSQL — postgresql+psycopg://user:pass@host/db
DATABASE_URL=
AUTH_SESSION_DAYS=30
# true — cookie только по HTTPS (на сервере с https обязательно)
COOKIE_SECURE=false

# Ночной обход объявлений по поискам клиентов: время ЧЧ:ММ (пусто — выключен)
REFRESH_AT=
REFRESH_PAGES=3
REFRESH_CHECK_LIMIT=40

# 2GIS — серверный ключ с доступом к каталогу и Raster Tiles API (подложка карты).
# Без ключа или при ошибке сервиса работает OpenStreetMap.
TWOGIS_API_KEY=
# Общий бюджет проверки инфраструктуры на один поиск (секунды).
PLACES_BUDGET_S=12
